{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CEDAR terminology resource links contract",
  "$ref": "#/$defs/ResourceDescription",
  "$defs": {
    "ConstraintVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "effectiveDate": {
          "type": "string"
        },
        "declaredVersion": {
          "type": "string"
        }
      }
    },
    "ConstraintReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sourceAcronym",
            "termIri"
          ],
          "properties": {
            "type": {
              "enum": [
                "class",
                "property"
              ]
            },
            "sourceSystem": {
              "type": "string",
              "minLength": 1
            },
            "sourceAcronym": {
              "type": "string",
              "minLength": 1
            },
            "sourceIri": {
              "type": "string",
              "format": "iri"
            },
            "version": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstraintVersion"
                },
                {
                  "const": "latest"
                }
              ]
            },
            "termIri": {
              "type": "string",
              "format": "iri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sourceAcronym",
            "termBaseIri"
          ],
          "properties": {
            "type": {
              "enum": [
                "branch",
                "valueSet"
              ]
            },
            "sourceSystem": {
              "type": "string",
              "minLength": 1
            },
            "sourceAcronym": {
              "type": "string",
              "minLength": 1
            },
            "sourceIri": {
              "type": "string",
              "format": "iri"
            },
            "version": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstraintVersion"
                },
                {
                  "const": "latest"
                }
              ]
            },
            "termBaseIri": {
              "type": "string",
              "format": "iri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sourceAcronym"
          ],
          "properties": {
            "type": {
              "enum": [
                "ontology"
              ]
            },
            "sourceSystem": {
              "type": "string",
              "minLength": 1
            },
            "sourceAcronym": {
              "type": "string",
              "minLength": 1
            },
            "sourceIri": {
              "type": "string",
              "format": "iri"
            },
            "version": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstraintVersion"
                },
                {
                  "const": "latest"
                }
              ]
            }
          }
        }
      ]
    },
    "ResourceDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "properties": {
        "constraint": {
          "$ref": "#/$defs/ConstraintReference"
        },
        "links": {
          "$ref": "#/$defs/ConstraintLinks"
        }
      }
    },
    "ConstraintLinks": {
      "description": "Optional public navigation links for any controlled-term constraint. Version remains on the constraint.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "landingPage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#@\\s\\\\]+(?:[/?#][^\\s\\\\]*)?$"
        },
        "icon": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#@\\s\\\\]+(?:[/?#][^\\s\\\\]*)?$"
        }
      },
      "additionalProperties": false
    }
  }
}
